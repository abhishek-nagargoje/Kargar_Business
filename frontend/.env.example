# ============================================
# Kargar FM - Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site (optional - has defaults in config/index.ts)
VITE_SITE_URL=https://your-frontend.vercel.app
VITE_SITE_NAME=KARGAR Facility Management

# Search engine verification tokens (Google Search Console / Bing Webmaster Tools) are set
# directly as static <meta> tags in index.html, not via env vars — update them there if the
# verification account changes.

# Analytics (optional - leave empty to disable)
# All of these are public identifiers (shipped to the browser), not secrets.
VITE_GA_MEASUREMENT_ID=
# Google Ads tag ID. Defaults to AW-18494930780 in config/index.ts if unset; set to empty to disable.
VITE_GOOGLE_ADS_ID=AW-18494930780
# Google Ads conversion labels (Goals -> Conversions -> action -> Tag setup -> "send_to": "AW-.../<LABEL>").
# Either the bare label or the full "AW-.../<LABEL>" value works. Empty = that conversion is not sent.
VITE_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
VITE_GOOGLE_ADS_FORM_CONVERSION_LABEL=
VITE_GTM_ID=
VITE_CLARITY_ID=
VITE_HOTJAR_ID=
VITE_SENTRY_DSN=

# Email (optional - leave empty to disable contact form email notifications)
VITE_RESEND_API_KEY=
